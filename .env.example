# .env example

# Django Settings
# Leave empty for local development (DEBUG=True uses a dev-only key). REQUIRED in production.
DJANGO_SECRET_KEY=
DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Database Settings
DATABASE_ENGINE=django_tenants.postgresql_backend
DATABASE_NAME=eventsaas
DATABASE_USER=postgres
DATABASE_PASSWORD=admin123
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# Multi-tenancy Settings
TENANT_MODEL=companies.Company
TENANT_DOMAIN_MODEL=companies.Domain

# Other settings can be added below as needed
# ── Security (production) ─────────────────────────────────────────────────
# DJANGO_SECRET_KEY and DATABASE_PASSWORD are REQUIRED when DEBUG=False (no fallbacks).
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CORS_ALLOW_ALL_ORIGINS_DEV=True            # dev only (ignored when DEBUG=False); never with credentials
# CSRF_TRUSTED_ORIGINS=https://*.event.skill.jobs
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# USE_X_FORWARDED_PROTO=True                 # behind a TLS-terminating proxy

# ── Identity rollout (see docs/EVENTOS_IDENTITY_MIGRATION.md) ─────────────
# legacy | dual | keycloak   (legacy = today's behaviour, no Keycloak)
EVENTOS_AUTH_MODE=legacy
EMPLOYER_AUTH_MODE=legacy

# ── Keycloak OIDC (see docs/EVENTOS_KEYCLOAK_SETUP.md) ────────────────────
# KEYCLOAK_ISSUER_URL=http://localhost:8081/realms/skilljobs
# KEYCLOAK_CLIENT_ID=eventos-web
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_API_AUDIENCE=eventos-api
# KEYCLOAK_BACKEND_AUDIENCE=skilljobs-api
# KEYCLOAK_ALLOWED_AZP=eventos-web,talentos-web,careeros-web
# KEYCLOAK_SCOPES=openid
# KEYCLOAK_POST_LOGOUT_REDIRECT_URI=         # optional; may contain {host}
# KEYCLOAK_PERSON_ID_SOURCE=claim            # claim (target) | backend_link (interim)
# KEYCLOAK_PERSON_ID_CLAIM=person_id
# KEYCLOAK_SESSION_REVALIDATE_SECONDS=300
# EVENTOS_OIDC_REQUIRE_HTTPS=True            # defaults to (not DEBUG)
# EVENTOS_PRIVILEGED_ACR=                    # Keycloak LoA required for privileged actions, e.g. 2

# ── Canonical Skill.jobs services (defaults fail closed) ──────────────────
# SKILLJOBS_BACKEND_URL=http://localhost:8000
# EVENTOS_SERVICE_TOKEN=
# EVENTOS_PROFILE_CLIENT=identity.profile_client.BackendMainProfileClient
# EVENTOS_EMPLOYER_CLIENT=identity.employer_client.UnavailableEmployerClient
# EVENTOS_ENTITLEMENT_CLIENT=identity.entitlement_client.UnavailableEntitlementClient
# EVENTOS_ORGANIZER_MEMBERSHIP_ROLES=owner,admin
# EVENTOS_PLATFORM_BASE_DOMAIN=event.skill.jobs
